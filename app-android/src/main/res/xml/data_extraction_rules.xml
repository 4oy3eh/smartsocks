<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up and transfer the settings, never the recordings (large, and shared explicitly instead),
     nor the "notification permission asked" flag (a restored install asks again). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="external" path="sessions/" />
        <exclude domain="file" path="sessions/" />
        <exclude domain="sharedpref" path="recording.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="external" path="sessions/" />
        <exclude domain="file" path="sessions/" />
        <exclude domain="sharedpref" path="recording.xml" />
    </device-transfer>
</data-extraction-rules>
